{
  "name": "discord-hk-server",
  "version": "1.0.0",
  "description": "A comprehensive Discord server management bot with modern features and integrations",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "deploy": "npm run build && npm start",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "moderation",
    "server-management",
    "discord.js",
    "automation"
  ],
  "author": "Hammad Khan",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.21.0",
    "@discordjs/rest": "^2.4.0",
    "@discordjs/builders": "^1.9.0",
    "@discordjs/voice": "^0.17.0",
    "dotenv": "^16.4.5",
    "mongoose": "^8.8.4",
    "winston": "^3.17.0",
    "node-cron": "^3.0.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.7.9",
    "zlib-sync": "^0.1.9",
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.4",
    "chalk": "^5.3.0",
    "moment": "^2.30.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/discord-hk-server.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/discord-hk-server/issues"
  },
  "homepage": "https://github.com/yourusername/discord-hk-server#readme"
}