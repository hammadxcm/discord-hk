# Discord Configuration (Required)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Database Configuration (Required)
MONGODB_URI=mongodb://localhost:27017/discord-hk

# Web Dashboard Configuration (Optional)
PORT=3000
JWT_SECRET=your_random_jwt_secret_here
SESSION_SECRET=your_random_session_secret_here

# External API Keys (Optional - for enhanced features)
YOUTUBE_API_KEY=your_youtube_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
OPENAI_API_KEY=your_openai_api_key_here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/bot.log

# Bot Configuration
BOT_PREFIX=!
BOT_ACTIVITY=Watching over the server
BOT_STATUS=online

# Features Toggle
ENABLE_MUSIC=true
ENABLE_LEVELING=true
ENABLE_MODERATION=true
ENABLE_TICKETS=true
ENABLE_ANALYTICS=true

# Moderation Settings
MAX_WARNS=3
MUTE_DURATION=3600000
AUTO_MOD_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=10

# Security
ENCRYPTION_KEY=your_encryption_key_here
WEBHOOK_SECRET=your_webhook_secret_here